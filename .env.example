# --- SEO ---
# 正規ドメイン。sitemap / robots / metadata / 構造化データの全URLの基準になる。
# 未設定時は lib/seo.ts の既定値 https://claft.keeponlearning.fun を使用。
NEXT_PUBLIC_SITE_URL=https://claft.keeponlearning.fun

# --- 計測（任意。未設定なら計測タグは出力されない） ---
# GA4 測定ID（GA管理画面 → 管理 → データストリーム で取得。例: G-XXXXXXXXXX）
NEXT_PUBLIC_GA_ID=
# Google Search Console「HTMLタグ」確認の content 値（meta name="google-site-verification"）
GOOGLE_SITE_VERIFICATION=

# --- ブログ（Notion をソースに /blog 配信。未設定なら /blog は「準備中」表示） ---
# notion.so/my-integrations で作成した内部インテグレーションの Secret
NOTION_TOKEN=
# 「CLAFT Blog（SEO/GEO記事）」DBのID
NOTION_BLOG_DB_ID=15060399-0a02-82c0-8cfe-81507416b075
# /blog を即時反映させる手動リフレッシュ用の合言葉（任意の長い文字列）
REVALIDATE_SECRET=

# --- 既存（カレンダー） ---
GOOGLE_CALENDAR_API_KEY=
KEEPON_CALENDAR_ID=
CLAFT_CALENDAR_ID=

# --- なんでも展示会プラットフォーム ---
# 公開可（クライアントに埋め込まれる）
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用（絶対にNEXT_PUBLIC_を付けない）
SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY は任意。未設定なら全コメントが手動承認待ちになります（AI自動承認なし・無料運用）
ANTHROPIC_API_KEY=
